#! /usr/bin/env ruby
#
# frozen_string_literal: true

require 'erbtex'

# Name space module for erbtex's ruby pre-processing of TeX and LaTeX files by
# ruby.
module ErbTeX
  if ARGV.empty?
    warn 'usage: erbtex [LaTex_filename]'
    exit(1)
  end

  cl = CommandLine.new(ARGV)
  exit ErbTeX.run(cl)
end
