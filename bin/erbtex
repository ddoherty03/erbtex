#! /usr/bin/env ruby
#
# frozen_string_literal: true

require 'erbtex'

# Name space module for erbtex's ruby pre-processing of TeX and LaTeX files by
# ruby.
module ErbTeX
  if ARGV.empty?
    warn 'usage: erbtex [LaTex_filename]'
    exit(1)
  end

  begin
    cl = CommandLine.new(ARGV)
    status = ErbTeX.run(cl)
  rescue SystemCallError, ArgumentError, NoInputFile => e
    warn "Error: #{e}"
    status = 1
  rescue ScriptError => e
    warn "Erubis pre-processing failed: #{e}"
    status = 1
  end
  exit status
end
